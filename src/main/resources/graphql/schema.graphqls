scalar BigDecimal

type Category {
    id: ID!
    name: String!
    images: String
}

type Product {
    id: ID!
    title: String!
    quantity: Int!
    description: String
    price: BigDecimal!
    userId: ID
    categoryId: ID
    categoryName: String
    userFullname: String
}

input CategoryInput {
    name: String!
    images: String
}

input ProductInput {
    title: String!
    quantity: Int!
    description: String
    price: BigDecimal!
    userId: ID!
    categoryId: ID!
}

type Query {
    categories: [Category!]!
    category(id: ID!): Category

    products: [Product!]!
    product(id: ID!): Product

    productsByPriceAsc: [Product!]!

    productsByCategory(categoryId: ID!): [Product!]!
}

type Mutation {
    createCategory(input: CategoryInput!): Category!

    updateCategory(
        id: ID!
        input: CategoryInput!
    ): Category!

    deleteCategory(id: ID!): Boolean!

    createProduct(input: ProductInput!): Product!

    updateProduct(
        id: ID!
        input: ProductInput!
    ): Product!

    deleteProduct(id: ID!): Boolean!
}
